# =============================================================================
# 91 — Выключение IPv6 (D7 / O9)
# =============================================================================
# Зачем: классификатор построен под IPv4. Глобальных IPv6-адресов сейчас нет,
# но disable-ipv6=no. Если провайдер включит RA/PD, часть abroad-трафика уйдёт
# по IPv6 мимо всей схемы — молча, без единого сигнала в диагностике.
#
# ⚠️  ТРЕБУЕТ ПЕРЕЗАГРУЗКИ РОУТЕРА. До неё настройка не вступает в силу.
# ⚠️  НЕ ПРИМЕНЯТЬ УДАЛЁННО без физического доступа к роутеру.
#     Перезагрузка домашнего шлюза, когда владелец в разъезде (O1) и все
#     остальные жители зависят от этого интернета — не та операция, которую
#     стоит делать вслепую.
#
# Применять на шаге 4, находясь дома.
# =============================================================================

/ipv6 settings
set disable-ipv6=yes

# Проверка ПОСЛЕ перезагрузки:
#   /ipv6 settings print          -> disable-ipv6: yes
#   /ipv6 address print           -> пусто
#
# Откат:
#   /ipv6 settings set disable-ipv6=no   (и снова перезагрузка)
