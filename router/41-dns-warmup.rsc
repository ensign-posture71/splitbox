# =============================================================================
# 41 — Прогрев DNS-кэша (лечит гонку первого запроса в схеме D19)
# =============================================================================
# ПРОБЛЕМА: записи в address-list `abroad` живут ровно столько же, сколько
# соответствующая запись в DNS-кэше роутера. У части сервисов TTL порядка
# минуты (у Instagram — около того), поэтому список постоянно пустеет:
# наблюдалось 1 адрес при 77 доменах в списке сервисов.
# Клиент, обратившийся в этот момент, промахивается мимо списка, его трафик
# уходит напрямую и упирается в блокировку. Второй запрос уже проходит —
# отсюда картина «первый раз не открывается, потом работает».
#
# РЕШЕНИЕ: роутер сам периодически резолвит все сервисные домены, поддерживая
# кэш тёплым, а значит и address-list наполненным.
#
# ВАЖНАЯ ДЕТАЛЬ, найденная опытным путём:
#   :resolve animego.org                      -> список НЕ наполняется
#   :resolve animego.org server=192.168.88.1  -> список наполняется
# Наполнение происходит только когда DNS-СЕРВЕР отвечает на запрос.
# Внутренний резолвер роутера этот механизм не задействует, поэтому роутер
# должен обращаться к самому себе как обычный клиент.
#
# ЧАСТОТА: 5 минут. Первая редакция стояла на 30 секундах, и это было ошибкой
# с точки зрения заметности. Замер показал: AdGuard обрабатывал ~28 запросов
# в секунду, половина уходила к апстримам, а самыми частыми именами в логе
# были ровно наши сервисы — phncdn.com, scdn.co, ytimg.com, twimg.com,
# oaiusercontent.com, по 76–79 раз за выборку.
#
# Содержимое запросов зашифровано (AdGuard ходит по DoH/DoT), но провайдеру
# видны объём и строгая периодичность: домашняя линия, круглосуточно,
# ровным пульсом раз в 30 секунд. Это аномалия сама по себе, независимо
# от того, что внутри.
#
# 5 минут дают примерно 0.5 запроса в секунду — в пятьдесят раз тише.
# ЦЕНА: у сервисов с коротким TTL (у Instagram — около минуты) запись
# успевает истечь между прогревами, и первое обращение может промахнуться.
# Это осознанный размен заметности на удобство в пользу заметности.
# =============================================================================

/system script
:if ([:len [find where name="abroad-warmup"]] = 0) do={
  add name=abroad-warmup dont-require-permissions=no policy=read,write,test \
      comment="D19: держит DNS-кэш тёплым, иначе address-list пустеет" \
      source={
        :foreach e in=[/ip dns static find where comment="svc"] do={
          :local n [/ip dns static get $e name]
          :do { :resolve $n server=192.168.88.1 } on-error={}
          # www-вариант прогревается отдельно: match-subdomain покрывает
          # поддомены при обращении КЛИЕНТА, но сам прогрев резолвит только
          # то имя, которое ему назвали. Наблюдалось на YouTube: в списке
          # лежали адреса youtube.com, а клиент шёл на www.youtube.com
          # и промахивался.
          :if ([:pick $n 0 4] != "www.") do={
            :do { :resolve ("www." . $n) server=192.168.88.1 } on-error={}
          }
        }
      }
}

/system scheduler
:if ([:len [find where name="abroad-warmup"]] = 0) do={
  add name=abroad-warmup interval=5m on-event="/system script run abroad-warmup" \
      comment="D19: прогрев DNS-кэша (5м — компромисс заметности, см. шапку файла)"
}

# Проверка после применения:
#   :put [:len [/ip firewall address-list find where list=abroad]]
# Должно держаться на уровне сотни-полутора и не проседать до единиц.
#
# Откат:
#   /system scheduler remove [find name=abroad-warmup]
#   /system script remove [find name=abroad-warmup]
