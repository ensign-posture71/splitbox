[Unit]
Description=Перечитывать подписку раз в сутки

[Timer]
# Раз в сутки: списки серверов у провайдеров меняются медленно, а каждый
# запрос к подписке — обращение к третьей стороне, которое видно провайдеру.
# Чаще смысла нет, реже — можно остаться со списком мёртвых серверов.
OnCalendar=daily
# Разброс, чтобы запрос не уходил ровно в полночь вместе со всеми
# остальными клиентами того же сервиса.
RandomizedDelaySec=2h
Persistent=true

[Install]
WantedBy=timers.target
