substack.com

# --- Домашние устройства [ОН] ------------------------------------------------
# Облака IoT-производителей, ограничивающие РФ. Трафика мало, зато эти
# устройства резолвят через AdGuard (видны в query-логе) — значит адреса,
# которые получит роутер, совпадут с теми, что получат сами железки.
# Для них IP-стеринг работает точно, в отличие от CDN-сервисов.
homeconnect.com
homeconnectegw.com
homeconnecthca.com
ui.com
ubnt.com

# --- Рабочие инструменты [ОН] ------------------------------------------------
notion.so
notion.site
figma.com
canva.com

# --- Кандидаты, требующие решения владельца ----------------------------------
# Раскомментировать осознанно — у каждого своя цена.
#
# youtube.com          [РФ] замедлен. НО: инфраструктура Google, очень большой
# googlevideo.com            объём трафика. Весь YouTube дома пойдёт через один
#                            VPS — упрётся в его канал. Решать отдельно.
#
# whatsapp.net         [РФ] статус ограничений менялся; включать, если реально
# whatsapp.com               не работает напрямую.
#
# mask.icloud.com      [ОН] iCloud Private Relay. Единственная часть Apple,
# mask-h2.icloud.com         которую есть смысл заворачивать.
#
# docker.io            [ОН] registry ограничивает РФ. Нужен, если дома собирают
# docker.com                 образы (на Proxmox есть mcp-docker).
#
# steampowered.com     работает напрямую; включать только при проблемах
# telegram.org         работает напрямую
