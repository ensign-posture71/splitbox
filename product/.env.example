# Скопируйте в .env и поправьте под себя. Всё остальное настраивается в вебке.

# Режим: vps (вход только WireGuard) или lan-gateway (коробка = шлюз всей сети;
# запускается с оверлеем compose.lan.yaml).
MODE=vps

# Порт WireGuard (UDP) — его нужно открыть/пробросить снаружи.
WG_PORT=51820

# Порт веб-интерфейса.
WEB_PORT=8443
